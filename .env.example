# Token longue durée lié à l'abonnement Claude (claude setup-token).
# Si vide, la CLI utilise la session déjà connectée sur la machine.
CLAUDE_CODE_OAUTH_TOKEN=
# Modèle passé à `claude --model`
MUE_CLAUDE_MODEL=sonnet
MUE_CLAUDE_TIMEOUT=120
DJANGO_DEBUG=1
# Facultatif : jeton GitHub (aucun droit requis) pour analyser plus de dépôts publics par heure
GITHUB_TOKEN=
